SUPPORT_URL=https://discord.gg/
BUY_INSTRUCTIONS=To purchase this product, open a ticket in our support channel or contact an administrator directly.

# Web Dashboard Port (Also supports WispByte SERVER_PORT automatically)
PORT=10000
